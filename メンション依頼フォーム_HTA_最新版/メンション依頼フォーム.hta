<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>メンション依頼フォーム</title>

<hta:application
    id="MentionRequestApp"
    applicationname="MentionRequest"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    maximizebutton="yes"
    minimizebutton="yes"
    navigable="no"
    scroll="no"
    selection="no"
    showintaskbar="yes"
    singleinstance="no"
    sysmenu="yes"
    version="1.0"
    windowstate="normal"
/>

<link rel="stylesheet" type="text/css" href="mention-form.css">

<script language="VBScript">
Function GetWindowsDisplayNameHTA()
    Dim shell
    Dim userName
    Dim domainName
    Dim objUser
    Dim fullName

    On Error Resume Next

    Set shell = CreateObject("WScript.Shell")
    userName = shell.ExpandEnvironmentStrings("%USERNAME%")
    domainName = shell.ExpandEnvironmentStrings("%USERDOMAIN%")
    fullName = ""

    Err.Clear

    If Len(domainName) > 0 And Len(userName) > 0 Then
        Set objUser = GetObject("WinNT://" & domainName & "/" & userName & ",user")

        If Err.Number = 0 Then
            If Not objUser Is Nothing Then
                fullName = Trim(CStr(objUser.FullName))
            End If
        End If
    End If

    If Len(fullName) > 0 Then
        GetWindowsDisplayNameHTA = fullName
    Else
        GetWindowsDisplayNameHTA = userName
    End If

    On Error GoTo 0
End Function
</script>

<script type="text/javascript" src="mention-form.js"></script>
<script type="text/javascript">
/* v28.16 Layout Fix compatibility overrides.
   The layout package is based on the v28.15 UI where proxy organization is removed,
   proxy CA is optional, and the input note follows the same-CA checkbox. */
function collectRequest(no){
    return {
        requestNo:no,
        organization:val("org"+no),
        caName:val("ca"+no),
        proxyOrganization:"",
        proxyCA1:val("proxyCA"+no+"_1"),
        proxyCA2:val("proxyCA"+no+"_2"),
        proxyCA3:val("proxyCA"+no+"_3"),
        mailMemo:val("mailMemo"+no),
        processedAt:val("processedAt"+no),
        dueDate:val("dueDate"+no),
        shortTime:checked("short"+no),
        urgent:checked("urgent"+no),
        type:val("type"+no)
    };
}

function validateRequestSection(i){
    if(!trimValue("org"+i)){
        markError("org"+i);
        showValidationModal(i,"依頼"+i+"：組織を入力してください","org"+i);
        return false;
    }
    if(!trimValue("ca"+i)){
        markError("ca"+i);
        showValidationModal(i,"依頼"+i+"：CA名を入力してください","ca"+i);
        return false;
    }
    if(!trimValue("mailMemo"+i)){
        markError("mailMemo"+i);
        showValidationModal(i,"依頼"+i+"：メールメモを入力してください","mailMemo"+i);
        return false;
    }
    if(!trimValue("processedAt"+i)){
        markError("processedAt"+i);
        showValidationModal(i,"依頼"+i+"：処理日時を入力してください","processedAt"+i);
        return false;
    }
    if(!trimValue("type"+i)){
        markError("type"+i);
        showValidationModal(i,"依頼"+i+"：タイプを選択してください","type"+i);
        return false;
    }
    return true;
}

function updateInputNoteVisibility(no,on){
    var note=$("inputNote"+no);
    if(note){
        note.style.display=on ? "none" : "block";
    }
}

var toggleSameCABase=toggleSameCA;
toggleSameCA=function(no){
    toggleSameCABase(no);
    updateInputNoteVisibility(no,checked("sameCA"+no));
};

var clearRequestBase=clearRequest;
clearRequest=function(no){
    clearRequestBase(no);
    if(no===2 || no===3){
        updateInputNoteVisibility(no,false);
    }
};
</script>
</head>

<body onload="initApp();">
<object id="HHCtrlMinimizeWindowObject"
        classid="clsid:adb880a6-d8ff-11cf-9377-00aa003b7a11"
        width="0" height="0"
        style="position:absolute;left:-9999px;top:-9999px;">
    <param name="Command" value="Minimize">
</object>

<div id="app">


    <div class="request-card card1" id="request1">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 1</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org1">
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca1">
                </div>

                <div class="option-zone option-inline">
                    <label>オプション</label>
                    <label class="checkline"><input type="checkbox" id="short1"> 時短</label>
                    <label class="checkline"><input type="checkbox" id="urgent1"> 至急</label>
                </div>

                <div class="field proxy-ca">
                    <label>代理CA名</label>
                    <input type="text" id="proxyCA1_1">
                    <input type="text" id="proxyCA1_2" class="stacked">
                    <input type="text" id="proxyCA1_3" class="stacked">
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo1">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt1">
                        </div>

                        <div class="field due">
                            <label>期日または面接日程</label>
                            <input type="text" id="dueDate1">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type1"></select>
                    </div>
                </div>

            </div>

            <div class="input-note" id="inputNote1">
                <div class="input-note-title">＜入力時の注意事項＞</div>
                <div>組織・CA名はCanvasからコピーしてください</div>
            </div>

            <div class="card-action-row">
                <button type="button" class="sub-button" id="btnAdd2" onclick="showRequest(2);">2件目を入力</button>
                <button type="button" class="sub-button clear-request-button" onclick="clearRequest(1);">クリア</button>
            </div>
        </div>
    </div>


    <div class="request-card card2 hidden" id="request2">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 2</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org2">
                    <label class="checkline same-ca-inline">
                        <input type="checkbox" id="sameCA2" onclick="toggleSameCA(2);">
                        <span id="sameCALabel2">依頼1と同一CA</span>
                    </label>
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca2">
                </div>

                <div class="option-zone option-inline">
                    <label>オプション</label>
                    <label class="checkline"><input type="checkbox" id="short2"> 時短</label>
                    <label class="checkline"><input type="checkbox" id="urgent2"> 至急</label>
                </div>

                <div class="field proxy-ca">
                    <label>代理CA名</label>
                    <input type="text" id="proxyCA2_1">
                    <input type="text" id="proxyCA2_2" class="stacked">
                    <input type="text" id="proxyCA2_3" class="stacked">
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo2">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt2">
                        </div>

                        <div class="field due">
                            <label>期日または面接日程</label>
                            <input type="text" id="dueDate2">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type2"></select>
                    </div>
                </div>

            </div>

            <div class="input-note" id="inputNote2">
                <div class="input-note-title">＜入力時の注意事項＞</div>
                <div>組織・CA名はCanvasからコピーしてください</div>
            </div>

            <div class="card-action-row">
                <button type="button" class="sub-button" id="btnAdd3" onclick="showRequest(3);">3件目を入力</button>
                <button type="button" class="cancel-request-button" onclick="requestCancel(2);">× この依頼を取り消す</button>
                <button type="button" class="sub-button clear-request-button" onclick="clearRequest(2);">クリア</button>
            </div>
        </div>
    </div>


    <div class="request-card card3 hidden" id="request3">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 3</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org3">
                    <label class="checkline same-ca-inline">
                        <input type="checkbox" id="sameCA3" onclick="toggleSameCA(3);">
                        <span id="sameCALabel3">依頼2と同一CA</span>
                    </label>
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca3">
                </div>

                <div class="option-zone option-inline">
                    <label>オプション</label>
                    <label class="checkline"><input type="checkbox" id="short3"> 時短</label>
                    <label class="checkline"><input type="checkbox" id="urgent3"> 至急</label>
                </div>

                <div class="field proxy-ca">
                    <label>代理CA名</label>
                    <input type="text" id="proxyCA3_1">
                    <input type="text" id="proxyCA3_2" class="stacked">
                    <input type="text" id="proxyCA3_3" class="stacked">
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo3">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt3">
                        </div>

                        <div class="field due">
                            <label>期日または面接日程</label>
                            <input type="text" id="dueDate3">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type3"></select>
                    </div>

                </div>

            </div>

            <div class="input-note" id="inputNote3">
                <div class="input-note-title">＜入力時の注意事項＞</div>
                <div>組織・CA名はCanvasからコピーしてください</div>
            </div>

            <div class="card-action-row">
                <button type="button" class="cancel-request-button" onclick="requestCancel(3);">× この依頼を取り消す</button>
                <button type="button" class="sub-button clear-request-button" onclick="clearRequest(3);">クリア</button>
            </div>
        </div>
    </div>


    <div id="footerBar">
        <div class="footer-field base-field">
            <label>拠点</label>
            <select id="requestBase"></select>
        </div>

        <div class="footer-field requester-field">
            <label>依頼者</label>
            <div id="requesterName" class="requester-value"></div>
        </div>

        <div class="footer-grow"></div>

        <div id="pendingRetryArea" class="pending-retry-area hidden">
            <div id="pendingRetryText" class="pending-retry-text"></div>
            <button type="button" id="retryPendingButton" onclick="retryPendingPackages();">未送信を再送</button>
        </div>

<button type="button" id="sendButton" onclick="sendRequest();">送信</button>
    </div>

</div>


<div id="cancelModalOverlay" class="modal-overlay hidden">
    <div id="cancelConfirmModal" class="validation-modal modal-request2 cancel-confirm-modal">
        <div id="cancelModalTitle" class="modal-title">依頼の取り消し確認</div>
        <div id="cancelModalMessage" class="modal-message"></div>
        <div class="cancel-modal-actions">
            <button type="button" id="cancelBackButton" class="cancel-modal-back" onclick="closeCancelConfirm();">戻る</button>
            <button type="button" id="cancelDoButton" class="cancel-modal-do" onclick="confirmCancelRequest();">取り消す</button>
        </div>
    </div>
</div>

<div id="modalOverlay" class="modal-overlay hidden">
    <div id="validationModal" class="validation-modal modal-neutral">
        <div id="modalTitle" class="modal-title">入力確認</div>
        <div id="modalMessage" class="modal-message"></div>
        <div class="modal-actions">
            <button type="button" id="modalOkButton" class="modal-ok" onclick="closeValidationModal();">OK</button>
        </div>
    </div>
</div>


<div id="systemModalOverlay" class="system-modal-overlay hidden">
    <div id="systemModal" class="system-modal system-modal-accepted">
        <div id="systemModalTitle" class="system-modal-title">受付完了</div>
        <div id="systemModalMessage" class="system-modal-message"></div>
        <div class="system-modal-actions">
            <button type="button" id="systemModalOkButton" onclick="hideSystemModal();">OK</button>
        </div>
    </div>
</div>

</body>
</html>
