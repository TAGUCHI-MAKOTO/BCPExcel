<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>メンション依頼フォーム</title>

<hta:application
    id="MentionRequestApp"
    applicationname="MentionRequest"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    maximizebutton="yes"
    minimizebutton="yes"
    navigable="no"
    scroll="yes"
    selection="no"
    showintaskbar="yes"
    singleinstance="no"
    sysmenu="yes"
    version="1.0"
    windowstate="normal"
/>

<link rel="stylesheet" type="text/css" href="mention-form.css">

<script language="VBScript">
Function GetWindowsDisplayNameHTA()
    Dim shell
    Dim userName
    Dim domainName
    Dim objUser
    Dim fullName

    On Error Resume Next

    Set shell = CreateObject("WScript.Shell")
    userName = shell.ExpandEnvironmentStrings("%USERNAME%")
    domainName = shell.ExpandEnvironmentStrings("%USERDOMAIN%")
    fullName = ""

    Err.Clear

    If Len(domainName) > 0 And Len(userName) > 0 Then
        Set objUser = GetObject("WinNT://" & domainName & "/" & userName & ",user")

        If Err.Number = 0 Then
            If Not objUser Is Nothing Then
                fullName = Trim(CStr(objUser.FullName))
            End If
        End If
    End If

    If Len(fullName) > 0 Then
        GetWindowsDisplayNameHTA = fullName
    Else
        GetWindowsDisplayNameHTA = userName
    End If

    On Error GoTo 0
End Function
</script>

<script type="text/javascript" src="mention-form.js"></script>
</head>

<body onload="initApp();">
<div id="app">

    <div class="request-card card1" id="request1">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 1</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org1">
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca1">
                </div>

                <div class="field proxy-org">
                    <label>代理CA組織</label>
                    <input type="text" id="proxyOrg1">
                </div>

                <div class="field proxy-ca">
                    <label>代理CA名</label>
                    <input type="text" id="proxyCA1_1">
                    <input type="text" id="proxyCA1_2" class="stacked">
                    <input type="text" id="proxyCA1_3" class="stacked">
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo1">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt1">
                        </div>

                        <div class="field due">
                            <label>期日</label>
                            <input type="text" id="dueDate1">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type1"></select>
                    </div>

                    <div class="add-row">
                        <button type="button" class="sub-button" id="btnAdd2" onclick="showRequest(2);">2件目を入力</button>
                    </div>
                </div>

                <div class="option-zone">
                    <label>オプション</label>
                    <label class="checkline"><input type="checkbox" id="short1"> 時短</label>
                    <label class="checkline"><input type="checkbox" id="urgent1"> 至急</label>
                </div>
            </div>
        </div>
    </div>

    <div class="request-card card2 hidden" id="request2">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 2</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org2">
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca2">
                </div>

                <div class="field proxy-org">
                    <label>代理CA組織</label>
                    <input type="text" id="proxyOrg2">
                </div>

                <div class="field proxy-ca">
                    <label>代理CA名</label>
                    <input type="text" id="proxyCA2_1">
                    <input type="text" id="proxyCA2_2" class="stacked">
                    <input type="text" id="proxyCA2_3" class="stacked">
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo2">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt2">
                        </div>

                        <div class="field due">
                            <label>期日</label>
                            <input type="text" id="dueDate2">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type2"></select>
                    </div>

                    <div class="add-row">
                        <button type="button" class="sub-button" id="btnAdd3" onclick="showRequest(3);">3件目を入力</button>
                    </div>
                </div>

                <div class="option-zone">
                    <label>オプション</label>
                    <label class="checkline"><input type="checkbox" id="short2"> 時短</label>
                    <label class="checkline"><input type="checkbox" id="urgent2"> 至急</label>
                </div>
            </div>
        </div>
    </div>

    <div class="request-card card3 hidden" id="request3">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 3</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org3">
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca3">
                </div>

                <div class="field proxy-org">
                    <label>代理CA組織</label>
                    <input type="text" id="proxyOrg3">
                </div>

                <div class="field proxy-ca">
                    <label>代理CA名</label>
                    <input type="text" id="proxyCA3_1">
                    <input type="text" id="proxyCA3_2" class="stacked">
                    <input type="text" id="proxyCA3_3" class="stacked">
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo3">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt3">
                        </div>

                        <div class="field due">
                            <label>期日</label>
                            <input type="text" id="dueDate3">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type3"></select>
                    </div>
                </div>

                <div class="option-zone">
                    <label>オプション</label>
                    <label class="checkline"><input type="checkbox" id="short3"> 時短</label>
                    <label class="checkline"><input type="checkbox" id="urgent3"> 至急</label>
                </div>
            </div>
        </div>
    </div>

    <div id="footerBar">
        <div class="footer-field base-field">
            <label>拠点</label>
            <select id="requestBase">
                <option value="">選択してください</option>
                <option value="呉服">呉服</option>
                <option value="札幌">札幌</option>
                <option value="新潟">新潟</option>
            </select>
        </div>

        <div class="footer-field requester-field">
            <label>依頼者</label>
            <div id="requesterName" class="requester-value"></div>
        </div>

        <div class="footer-grow"></div>
        <button type="button" id="sendButton" onclick="sendRequest();">送信</button>
    </div>

</div>
</body>
</html>
